
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AttendEase | Register Student</title>

    <!-- Bootstrap CSS for page layout and styling -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">

    <!-- Existing project CSS files -->
    <link rel="stylesheet" href="/css/admin_dashbord.css">
    <link rel="stylesheet" href="/css/student_register.css">
</head>

<body>

<div class="admin-layout">

    <!-- Common navbar -->
    <%- include('navbar') %>

    <main class="main-content">
        <div class="register-page">

            <!-- Page heading -->
            <header class="page-header">
                <button type="button"
                        class="sidebar-toggle"
                        id="sidebarToggle"
                        aria-label="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>

                <div class="header-icon">
                    <i class="bi bi-person-plus"></i>
                </div>

                <div>
                    <h4>Register New Student</h4>
                </div>
            </header>

            <!-- Registration form container -->
            <div class="form-container">

                <div class="form-heading">
                    <div>
                        <h3>Student Information</h3>
                        <p>Enter the student's details below.</p>
                    </div>

                    <span class="required-note">
                        <span>*</span> Required fields
                    </span>
                </div>

                <!-- Student registration form -->
                <form action="/admin/register_student"
                      method="POST"
                      id="studentRegisterForm">

                    <!-- Student personal information -->
                    <div class="form-section">

                        <div class="section-title">
                            <div class="section-icon">
                                <i class="bi bi-person-vcard"></i>
                            </div>

                            <div>
                                <h5>Personal Details</h5>
                                <p>Basic information about the student</p>
                            </div>
                        </div>

                        <div class="row g-4">

                            <div class="col-md-6">
                                <label for="student_name" class="form-label">
                                    Student Full Name <span>*</span>
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-person"></i>
                                    <input type="text"
                                           class="form-control"
                                           id="student_name"
                                           name="student_name"
                                           placeholder="Enter full name"
                                           maxlength="100"
                                           required>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label for="student_roll_no" class="form-label">
                                    Student Roll Number <span>*</span>
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-card-text"></i>
                                    <input type="text"
                                           class="form-control"
                                           id="student_roll_no"
                                           name="student_roll_no"
                                           placeholder="e.g. STU001"
                                           maxlength="50"
                                           required>
                                </div>
                            </div>
                                  <div class="col-md-6">
                                <label for="student_class" class="form-label">
                                    Student Class <span>*</span> 
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-card-text"></i>
                                    <input type="text"
                                           class="form-control"
                                           id="student_class"
                                           name="student_class"
                                           placeholder="e.g. 8th,Bsc"
                                           maxlength="50"
                                           required>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label for="student_email" class="form-label">
                                    Email Address
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-envelope"></i>
                                    <input type="email"
                                           class="form-control"
                                           id="student_email"
                                           name="student_email"
                                           placeholder="student@example.com"
                                           maxlength="150">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label for="student_phone" class="form-label">
                                    Mobile Number
                                </label>

                                <div class="input-wrapper">
                                    <i class="bi bi-telephone"></i>
                                    <input type="tel"
                                           class="form-control"
                                           id="student_phone"
                                           name="student_phone"
                                           placeholder="Enter mobile number"
                                           maxlength="15">
                                </div>
                            </div>

                            <div class="col-12">
                                <label for="student_address" class="form-label">
                                    Residential Address
                                </label>

                                <div class="input-wrapper textarea-wrapper">
                                    <i class="bi bi-geo-alt"></i>
                                    <textarea class="form-control"
                                              id="student_address"
                                              name="student_address"
                                              rows="3"
                                              maxlength="200"
                                              placeholder="Enter complete address"></textarea>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <!-- Face registration section -->
                    <div class="form-section">

                        <div class="section-title">
                            <div class="section-icon face-icon">
                                <i class="bi bi-person-bounding-box"></i>
                            </div>

                            <div>
                                <h5>Face Registration</h5>
                                <p>Register the student's face for attendance verification</p>
                            </div>
                        </div>

                        <div class="face-card">

                            <!-- Live camera preview -->
                            <div class="camera-preview" id="cameraPreview">

                                <div class="camera-placeholder" id="cameraPlaceholder">
                                    <i class="bi bi-camera-video"></i>
                                    <h6>Camera Preview</h6>
                                    <p>Start the camera to register the student's face.</p>
                                </div>

                                <video id="video"
                                       autoplay
                                       muted
                                       playsinline
                                       hidden></video>
                                       <canvas id="capturedFace" hidden></canvas>

                            </div>

                            <!-- Camera status and controls -->
                            <div class="camera-info">

                                

                                <p>
                                    Keep the student's face clearly visible
                                    with sufficient lighting.
                                </p>

                                <!-- Generated face descriptor is submitted to Express -->
                                <input type="hidden"
                                       name="face_descriptor"
                                       id="face_descriptor">

                                <button type="button"
                                        class="btn-camera"
                                        id="startCameraBtn">
                                    <i class="bi bi-camera-video"></i>
                                    Start Camera
                                </button>

                                <!-- Capture Face button -->
                                <button type="button"
                                        class="btn-camera"
                                        id="captureFaceBtn"
                                        disabled>
                                    <i class="bi bi-person-bounding-box"></i>
                                    Capture Face
                                </button>

                                <p class="face-result" id="faceResult">
                                    Face registration is pending.
                                </p>

                            </div>
                        </div>
                    </div>

                    <!-- Form action buttons -->
                    <div class="form-actions">

                        <button type="reset"
                                class="btn-reset"
                                id="resetBtn">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Reset
                        </button>

                        <button type="submit" class="btn-submit">
                            <i class="bi bi-person-check"></i>
                            Register Student
                        </button>

                    </div>

                </form>
            </div>
        </div>

        <!-- Common footer -->
        <%- include('footer') %>
    </main>
</div>

<script type="module" src="/js/face_register.js"></script>

</body>
</html>
