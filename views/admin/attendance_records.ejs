
<!DOCTYPE html>
<html>
<head>
    <title>Attendance Records</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/admin_dashbord.css">

    <style>
        body {
            background-color: #f4f6fa;
            font-family: Arial, sans-serif;
            color: #243247;
        }

        .page-container {
            max-width: 1250px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .page-heading {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
        }

        .heading-icon {
            width: 55px;
            height: 55px;
            background: #e8efff;
            color: #3157c8;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
        }

        .page-heading h2 {
            font-size: 26px;
            font-weight: 700;
            margin: 0 0 5px;
        }

        .page-heading p {
            margin: 0;
            color: #7b8798;
            font-size: 14px;
        }

        .custom-card {
            background: white;
            border: 1px solid #e7ebf2;
            border-radius: 14px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 18px rgba(25, 42, 70, 0.04);
        }

        .section-title {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #526176;
            margin-bottom: 8px;
        }

        .form-control,
        .form-select {
            min-height: 44px;
            border-color: #dfe5ee;
            border-radius: 8px;
            font-size: 14px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #5275e8;
            box-shadow: 0 0 0 3px rgba(82, 117, 232, 0.12);
        }

        .btn {
            min-height: 42px;
            border-radius: 8px;
            padding: 9px 18px;
            font-size: 14px;
            font-weight: 600;
        }

        .btn-search {
            background: #3157c8;
            color: white;
            border: 1px solid #3157c8;
        }

        .btn-search:hover {
            background: #2446aa;
            color: white;
        }

        .btn-reset {
            background: white;
            color: #526176;
            border: 1px solid #dfe5ee;
        }

        .btn-reset:hover {
            background: #f1f4f9;
        }

        .table-card {
            background: white;
            border: 1px solid #e7ebf2;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 18px rgba(25, 42, 70, 0.04);
        }

        .table-header {
            padding: 22px 25px;
            border-bottom: 1px solid #e9edf4;
        }

        .table-header h5 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
        }

        .table-header p {
            margin: 5px 0 0;
            font-size: 13px;
            color: #7b8798;
        }

        .table {
            margin-bottom: 0;
            vertical-align: middle;
            white-space: nowrap;
        }

        .table thead th {
            background: #f7f9fc;
            color: #526176;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 16px;
            border-bottom: 1px solid #e5eaf2;
        }

        .table tbody td {
            padding: 16px;
            font-size: 13px;
            color: #37465b;
            border-bottom: 1px solid #edf0f5;
        }

        .table tbody tr:hover {
            background: #f8faff;
        }

        .serial-number {
            color: #7b8798;
            font-weight: 600;
        }

        .student-name {
            font-weight: 600;
            color: #243247;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            background: #e5f7ed;
            color: #18864b;
            text-transform: capitalize;
        }

        .empty-state {
            padding: 45px 15px !important;
            text-align: center;
            color: #7b8798 !important;
        }

        .empty-state i {
            display: block;
            font-size: 30px;
            margin-bottom: 10px;
            color: #a4afc0;
        }

        @media (max-width: 768px) {
            .page-container {
                margin: 25px auto;
                padding: 0 12px;
            }

            .custom-card {
                padding: 18px;
            }

            .page-heading h2 {
                font-size: 22px;
            }

            .table-header {
                padding: 18px;
            }
        }
    </style>
</head>

<body>

<div class="admin-layout">
    <%- include('navbar') %>

    <main class="main-content">
<div class="page-container">
    <!-- Page Heading -->
    <div class="page-heading">
        <div class="heading-icon">
            <i class="bi bi-calendar2-check"></i>
        </div>

        <div>
            <h2>Attendance Records</h2>
            <p>View and manage student attendance records.</p>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="custom-card">

        <div class="section-title">
            <i class="bi bi-funnel me-2 text-primary"></i>
            Filter Attendance
        </div>

        <form action="/admin/attendance_records" method="GET">

            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label">Attendance Date</label>

                    <input
                        type="date"
                        name="attendance_date"
                        class="form-control"
                        value="<%= attendance_date || '' %>"
                    >
                </div>

                <div class="col-md-4">
                    <label class="form-label">Student Class</label>

                    <select name="student_class" class="form-select">

                        <option value="">Select Class</option>

                        <% for(var j = 0; j < classes.length; j++) { %>

                            <option
                                value="<%= classes[j].student_class %>"
                                <%= selected_class == classes[j].student_class ? 'selected' : '' %>
                            >
                                <%= classes[j].student_class %>
                            </option>

                        <% } %>

                    </select>
                </div>

                <div class="col-md-4 d-flex gap-2">

                    <button type="submit" class="btn btn-search">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>

                    <button
                        type="button"
                        class="btn btn-reset"
                        onclick="window.location.href='/admin/attendance_records'"
                    >
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Reset
                    </button>

                </div>

            </div>

        </form>
    </div>

    <!-- Attendance Table -->
    <div class="table-card">

        <div class="table-header">
            <h5>
                <i class="bi bi-table me-2 text-primary"></i>
                Student Attendance List
            </h5>

            <p>Attendance details based on your selected filters.</p>
        </div>

        <div class="table-responsive">

            <table class="table">

                <thead>
                    <tr>
                        <th>Sr No</th>
                        <th>Attendance Date</th>
                        <th>Student Name</th>
                        <th>Student Email</th>
                        <th>Roll No</th>
                        <th>Class</th>
                        <th>Attendance Status</th>
                    </tr>
                </thead>

                <tbody>

                    <% if(data.length > 0) { %>

                        <% for(var i = 0; i < data.length; i++) { %>

                            <tr>
                                <td class="serial-number">
                                    <%= i + 1 %>
                                </td>

                                <td>
                                    <i class="bi bi-calendar3 me-1 text-secondary"></i>
                                    <%= new Date(data[i].attendance_date).toLocaleDateString('en-GB') %>
                                </td>

                                <td class="student-name">
                                    <i class="bi bi-person-circle me-1 text-secondary"></i>
                                    <%= data[i].student_name %>
                                </td>

                                <td>
                                    <%= data[i].student_email %>
                                </td>

                                <td>
                                    <%= data[i].student_roll_no %>
                                </td>

                                <td>
                                    <%= data[i].student_class %>
                                </td>

                                <td>
                                    <%if(data[i].status === 'Present') { %>
                                        <span class="status-badge present bg-success text-white">
                                            <%= data[i].status %>
                                        </span>
                                    <% } else { %>
                                        <span class="status-badge absent bg-danger text-white">
                                            <%= data[i].status %>
                                        </span>
                                    <% } %>
                                
                                </td>
                            </tr>

                        <% } %>

                    <% } else { %>

                        <tr>
                            <td colspan="7" class="empty-state">
                                <i class="bi bi-inbox"></i>
                                <strong>No attendance records found</strong>
                                <div class="mt-2">
                                    Try selecting a different date or class.
                                </div>
                            </td>
                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>
    </div>

</div>
    <%- include('footer') %>
    </main>
</div>

</body>
</html>
