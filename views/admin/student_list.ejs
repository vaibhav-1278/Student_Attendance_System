<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AttendEase | Student List</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin_dashbord.css">
    <link rel="stylesheet" href="/css/student_register.css">
    <style>
        body {
            margin: 0;
            background: #f4f7fc;
            font-family: Arial, sans-serif;
            color: #263247;
        }

        .student-list-page {
            padding: 35px;
            min-height: 70vh;
        }

        .page-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .page-subtitle {
            color: #7b8495;
            font-size: 14px;
        }

        .student-count {
            background: #ffffff;
            border: 1px solid #e5eaf2;
            border-radius: 12px;
            padding: 22px 25px;
            margin: 25px 0;
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .count-icon {
            width: 55px;
            height: 55px;
            flex-shrink: 0;
            border-radius: 12px;
            background: #edf2ff;
            color: #3157d5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
        }

        .count-label {
            font-size: 14px;
            color: #7b8495;
        }

        .count-number {
            font-size: 27px;
            font-weight: bold;
            color: #263247;
        }

        .student-card {
            background: #ffffff;
            border: 1px solid #e5eaf2;
            border-radius: 12px;
            overflow: hidden;
        }

        .card-header-custom {
            padding: 23px 25px;
            border-bottom: 1px solid #e9edf4;
        }

        .section-title {
            font-size: 19px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .student-table {
            width: 100%;
            margin: 0;
            border-collapse: collapse;
        }

        .student-table thead th {
            background: #f8faff;
            color: #64748b;
            font-size: 12px;
            text-transform: uppercase;
            padding: 17px 20px;
            white-space: nowrap;
            border-bottom: 1px solid #e5eaf2;
        }

        .student-table tbody td {
            padding: 18px 20px;
            font-size: 14px;
            vertical-align: middle;
            border-bottom: 1px solid #edf0f5;
        }

        .student-table tbody tr:last-child td {
            border-bottom: none;
        }

        .student-id {
            color: #3157d5;
            font-weight: 600;
        }

        .roll-number {
            display: inline-block;
            background: #edf2ff;
            color: #3157d5;
            padding: 6px 10px;
            border-radius: 6px;
            font-weight: 600;
            white-space: nowrap;
        }

        .btn-edit,
        .btn-delete {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            padding: 7px 11px;
            border-radius: 6px;
        }

        .btn-edit {
            background: #edf2ff;
            color: #3157d5;
        }

        .btn-delete {
            background: #fff0f0;
            color: #dc3545;
        }

        .btn-edit:hover {
            background: #dce6ff;
        }

        .btn-delete:hover {
            background: #ffe0e0;
        }

        .table-footer {
            padding: 17px 25px;
            color: #7b8495;
            font-size: 13px;
            border-top: 1px solid #edf0f5;
        }

        @media (max-width: 768px) {
            .student-list-page {
                padding: 18px;
            }

            .page-title {
                font-size: 23px;
            }

            .student-count {
                padding: 18px;
            }
        }
    </style>
</head>

<body>

    <div class="admin-layout">
        <%- include('navbar') %>

        <main class="main-content student-list-page">

        <div>
            <h1 class="page-title">Student Management</h1>
            <p class="page-subtitle">
                Manage and view all registered student information.
            </p>
        </div>

        <div class="student-count">
            <div class="count-icon">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <div class="count-label">Total Registered Students</div>
                <div class="count-number"><%= data.length %></div>
            </div>
        </div>

        <div class="student-card">

            <div class="card-header-custom">
                <h5 class="section-title">Registered Students</h5>
                <p class="page-subtitle mb-0">
                    Student details registered in AttendEase.
                </p>
            </div>

            <div class="table-responsive">
                <table class="student-table">

                    <thead>
                        <tr>
                            <th>Student ID</th>
                            <th>Student Name</th>
                            <th>Roll Number</th>
                            <th>Class</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Address</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% for (var i = 0; i < data.length; i++) { %>
                        <tr>
                          <td class="student-id">
                            #<%= i + 1 %>
                             </td>

                            <td class="fw-semibold">
                                <%= data[i].student_name %>
                            </td>

                            <td>
                                <span class="roll-number">
                                    <%= data[i].student_roll_no %>
                                </span>
                            </td>
                             <td>
                                <span class="roll-number">
                                    <%= data[i].student_class %>
                                </span>
                            </td>

                            <td><%= data[i].student_email %></td>

                            <td><%= data[i].student_phone %></td>

                            <td><%= data[i].student_address %></td>

                            <td>
                                <div class="d-flex gap-2">
                                    <a href="/admin/edit_student/<%= data[i].student_id %>"
                                       class="btn-edit"
                                       title="Edit Student">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a href="/admin/delete_student/<%= data[i].student_id %>"
                                       class="btn-delete"
                                       title="Delete Student">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <% } %>

                        <% if (data.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-3 d-block mb-2"></i>
                                No students registered yet.
                            </td>
                        </tr>
                        <% } %>
                    </tbody>

                </table>
            </div>

           

        </div>

            <%- include('footer') %>
        </main>
    </div>

</body>
</html>
