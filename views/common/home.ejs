<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="/css/common.css">
    <title>AttendEase | Face Recognition Attendance</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('navbar') %>

    <main>
        <!-- Hero Section -->
        <section class="hero-section ">
            <div class="container">
                <div class="row align-items-center g-5">

                    <div class="col-lg-7">
                        <div class="hero-badge">
                            <i class="bi bi-shield-check me-2"></i>
                            Smart &amp; Secure Attendance
                        </div>

                        <h1 class="hero-title mt-4">
                            Attendance Made
                            <span>Smarter.</span>
                            <br>Faster. Easier.
                        </h1>

                        <p class="hero-description mt-4">
                            A modern face recognition attendance system
                            designed to simplify student attendance management
                            with a secure and easy-to-use interface.
                        </p>

                        <div class="d-flex flex-wrap gap-3 mt-4">
                            <a href="/admin/admin_login" class="btn btn-primary-custom btn-lg text-white">
                                Get Started
                                <i class="bi bi-arrow-right ms-2"></i>
                            </a>

                            <a href="#features" class="btn btn-outline-custom text-dark fw-2 btn-lg">
                                Explore Features
                            </a>
                        </div>

                        <div class="hero-trust mt-4">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            Simple management &nbsp;·&nbsp;
                            <i class="bi bi-check-circle-fill me-2"></i>
                            Face-based verification
                        </div>
                    </div>

                    <!-- Right-side visual -->
                    <div class="col-lg-5">
                        <div class="visual-card">
                            <div class="visual-top">
                                <div>
                                    <span class="visual-label">ATTENDANCE SYSTEM</span>
                                    <h5 class="mt-2 mb-0">Smart Recognition</h5>
                                </div>
                                <span class="status-dot"></span>
                            </div>

                            <div class="face-illustration">
                                <div class="scan-corner corner-tl"></div>
                                <div class="scan-corner corner-tr"></div>
                                <div class="scan-corner corner-bl"></div>
                                <div class="scan-corner corner-br"></div>

                                <i class="bi bi-person-bounding-box face-icon"></i>

                                <div class="scan-line"></div>
                            </div>

                            <div class="verification-status">
                                <div class="verified-icon">
                                    <i class="bi bi-shield-check"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1">Face Verification</h6>
                                    <p class="mb-0">Designed for secure verification</p>
                                </div>
                            </div>

                            <div class="visual-bottom">
                                <i class="bi bi-lock-fill me-2"></i>
                                Smart. Simple. Organized.
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

      


<!-- Features Section -->
<section class="features-section" id="features">
    <div class="container">

        <div class="section-heading text-center">
            <span class="section-label">CORE FEATURES</span>
            <h2>AttendEase Features</h2>
            <p>
                A simple system to register students, verify faces,
                manage daily attendance, and view attendance records.
            </p>
        </div>

        <div class="row g-4 mt-3">

            <!-- Student Registration -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon blue-icon">
                        <i class="bi bi-person-vcard"></i>
                    </div>
                    <h5>Student Registration</h5>
                    <p>
                        Register students by entering their name,
                        email, phone number, address, roll number,
                        and class. Capture and save face descriptor
                        data for future face verification.
                    </p>
                </div>
            </div>

            <!-- Student List -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon green-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <h5>Student Management</h5>
                    <p>
                        View the list of registered students and
                        access their stored details. Keep student
                        information organized in one place for
                        attendance management.
                    </p>
                </div>
            </div>

            <!-- Face Verification -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon purple-icon">
                        <i class="bi bi-person-bounding-box"></i>
                    </div>
                    <h5>Face Verification</h5>
                    <p>
                        Capture a student's face through the camera
                        and compare it with the registered face
                        descriptor. Mark attendance as present
                        when the face matches.
                    </p>
                </div>
            </div>

            <!-- Attendance Management -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon blue-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h5>Attendance Management</h5>
                    <p>
                        Select the attendance date and class to
                        view students. Verify faces to mark students
                        present or use the Absent option to record
                        their absence.
                    </p>
                </div>
            </div>

            <!-- Attendance Records -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon green-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                    <h5>Attendance Records</h5>
                    <p>
                        View saved attendance records with student
                        details, attendance date, and status.
                        Filter records by class and date to find
                        the required information.
                    </p>
                </div>
            </div>

            <!-- Admin Dashboard -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon purple-icon">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <h5>Admin Dashboard</h5>
                    <p>
                        View the total number of registered students,
                        unique classes, and the five most recent
                        attendance records from one dashboard.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


    </main>

    <%- include('footer') %>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>